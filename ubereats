        d = br.api(args.endpoint, json.loads(args.body or "{}"))
    return emit(ok(d), True)


COOKIE_PAIR = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+=[\x21-\x7e]*$")


def clean_cookie(raw):
    """Keep only valid name=value pairs; refuse text that is not a Cookie header."""
    raw = (raw or "").strip()
    if raw.lower().startswith("cookie:"):
        raw = raw.split(":", 1)[1].strip()
    pairs = [p.strip() for p in raw.replace("\n", ";").split(";")]
    good = [p for p in pairs if p and COOKIE_PAIR.match(p)]
    bad = [p for p in pairs if p and not COOKIE_PAIR.match(p)]
    if not good or not any(p.startswith(("jwt-session=", "sid=", "csid=")) for p in good):
        preview = raw[:40].encode("ascii", "replace").decode()
        raise Auth("that does not look like an Uber Eats Cookie header "
                   f"(starts with {preview!r}). In DevTools > Network, click a ubereats.com "
                   "request > Headers > Request Headers, copy the value of `Cookie`")
    if bad:
        print(f"note: dropped {len(bad)} malformed cookie part(s)", file=sys.stderr)
    return "; ".join(good)


def _verify(cookie, debug):
    try:
        u = Http({"cookie": cookie}, debug).api("getUserV1", {})
    except (Auth, ApiError) as e:
        raise Auth(f"that session is not signed in to Uber Eats ({e}). "
                   "sign in on ubereats.com first, then copy the session again")
    if not u.get("uuid"):
        raise Auth("getUserV1 returned no user - not signed in")
    return u


def _read_cookie_tty():
    """Read one long line from a terminal.

    The Linux tty line editor (canonical mode) holds at most 4095 bytes per line; a longer
    paste fills it and Enter is then ignored. Uber Eats cookies are often ~5-8 KB, so turn
    canonical mode off and read the bytes ourselves until Enter.
    """
    import termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    print("paste the Cookie header, then press Enter (input hidden):", file=sys.stderr)
    buf = bytearray()
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        while True:
            ch = os.read(fd, 65536)
            if not ch:
                break
            if b"\x03" in ch:
                raise KeyboardInterrupt
            buf += ch
            if b"\r" in ch or b"\n" in ch:
                break
            print(f"\r{len(buf)} bytes", end="", file=sys.stderr, flush=True)
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        print(file=sys.stderr)
    return buf.decode("utf-8", "replace").splitlines()[0] if buf else ""


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def cmd_login(args):
    if args.from_browser:
        with Browser(args.debug, args.cdp) as br:
            cks = br.cookies()
        cookie = "; ".join(f"{c['name']}={c['value']}" for c in cks
                           if c["name"] != "uev2.loc")
        src = f"browser {args.cdp or CDP}"
    elif args.from_clipboard:
        cookie = _clipboard()
        src = "clipboard"
    elif args.cookie_stdin:
        cookie = (_read_cookie_tty() if sys.stdin.isatty() else sys.stdin.read()).strip()
        src = "stdin"
    else:
        raise ApiError("pick --from-browser, --from-clipboard or --cookie-stdin", {"usage": True})
    cookie = clean_cookie(cookie)
    u = _verify(cookie, args.debug)
    st = load_state()
    st.pop("source", None)
    st.update(cookie=cookie, cookie_in_keyring=bool(args.keyring),
              user={"uuid": u.get("uuid"), "first_name": u.get("firstName")},
              logged_in_at=int(time.time()), exp=jwt_exp(cookie), login_source=src)
    if args.keyring:
        _keyring("set", cookie)
    save_state(st)
    out = {"user": st["user"], "stored": "keyring" if args.keyring else STATE_FILE,
           "expires": st["exp"]}
    return emit(ok(out), args.json,
                lambda: f"signed in as {u.get('firstName') or u.get('uuid')}; "
                        f"session saved to {out['stored']}")


def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        _keyring("del")
    for k in ("cookie", "cookie_in_keyring", "user", "logged_in_at", "exp",
              "login_source", "source"):
        st.pop(k, None)
    save_state(st)
    return emit(ok({"logged_out": True}), args.json, "session removed")


def cmd_whoami(args):
