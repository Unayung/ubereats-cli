def cmd_store(args):
    sid = store_uuid(args.store)
    with Auto(args) as br:
        s = parse_store(br.api("getStoreV1", {"storeUuid": sid,
                                              "diningMode": args.mode}))
    if not args.all:
        s["items"] = [i for i in s["items"] if not i["duplicate"]]
    if args.available:
        s["items"] = [i for i in s["items"] if not i["sold_out"]]
    if args.grep:
        g = args.grep.lower()
        s["items"] = [i for i in s["items"]
                      if g in (i["title"] or "").lower() or g in i["description"].lower()]

    def human():
        head = (f"{s['title']}  ({'open' if s['is_open'] else 'CLOSED'}"
                f"{', ' + s['eta'] if s['eta'] and s['is_open'] else ''})\n"
                f"{s['url'] or ''}\n")
        if s["closed_message"]:
            head += s["closed_message"] + "\n"
        rows = [[clip(i["section"], 16), clip(i["title"], 34),
                 i["price_text"] or i["price"], "SOLD OUT" if i["sold_out"] else "",
                 "+opt" if i["has_options"] else ""] for i in s["items"]]
        return head + "\n" + table(rows, ["section", "item", "price", "", ""])
