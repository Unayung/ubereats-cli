class Net(Exception):
    pass


class Blocked(Net):
    pass


class Auth(Exception):
    pass


class ApiError(Exception):
    def __init__(self, msg, detail=None):
        super().__init__(msg)
        self.detail = detail


# ---------------------------------------------------------------- envelope
def ok(data):
    return {"ok": True, "data": data}


def err(msg, code=EX_ERR, **detail):
    return {"ok": False, "error": {"message": msg, "code": code,
                                   "detail": detail or None}}


def emit(payload, as_json, human=None):
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif payload.get("ok"):
        print(human() if callable(human) else
              (human if human is not None else
               json.dumps(payload["data"], ensure_ascii=False, indent=2)))
    else:
        print(payload["error"]["message"], file=sys.stderr)
    return EX_OK if payload.get("ok") else payload["error"]["code"]


def _w(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in str(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w(c) for c in col) for col in cols]
    pad = lambda t, w: str(t) + " " * max(0, w - _w(t))  # noqa: E731
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(pad(c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def clip(text, n):
    text = (text or "").replace("\n", " ").strip()
    return text if _w(text) <= n else text[: max(1, n // 2)] + "…"


def money(minor):
    if minor is None:
        return None
    return minor / 100


# -------------------------------------------------------- CDP (stdlib ws)
class WS:
    def __init__(self, url, timeout=60):
        if not url.startswith("ws://"):
            raise Net(f"unsupported websocket url {url}")
        hostport, path = url[5:].split("/", 1)
        host, port = hostport.rsplit(":", 1)
        try:
            self.s = socket.create_connection((host, int(port)), timeout=timeout)
        except OSError as e:
            raise Net(f"cannot reach browser at {hostport}: {e}")
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise Net("websocket handshake closed")
            buf += chunk
        if b" 101 " not in buf.split(b"\r\n")[0]:
            raise Net("websocket handshake refused (start Edge with "
                      "--remote-allow-origins='*')")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]
        self.n = 0

    def _recv(self, n):
        while len(self.rest) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise Net("browser closed the connection")
            self.rest += chunk
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def _send(self, obj):
        data = json.dumps(obj).encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        mask = os.urandom(4)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4]
                                          for i, b in enumerate(data)))

    def _recv_msg(self):
        msg = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            payload = self._recv(n)
            op = b0 & 0x0F
            if op == 8:
                raise Net("browser closed the websocket")
            if op in (9, 10):
                continue
            msg += payload
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, method, **params):
        self.n += 1
        i = self.n
        self._send({"id": i, "method": method, "params": params})
        while True:
            m = self._recv_msg()
            if m.get("id") == i:
                if "error" in m:
                    raise Net(f"{method}: {m['error'].get('message')}")
                return m["result"]

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def _http_json(path):
    try:
        with urllib.request.urlopen(CDP + path, timeout=5) as r:
            return json.loads(r.read())
    except OSError as e:
        raise Net(f"no browser on {CDP} ({e}). start Edge with "
                  "--remote-debugging-port=9222")


class Browser:
    """One background tab on ubereats.com, closed on exit. Never focused."""

    def __init__(self, debug=False, cdp=None):
        global CDP
        if cdp:
            CDP = cdp
        self.debug = debug
        self.ver = _http_json("/json/version")
        self.b = WS(self.ver["webSocketDebuggerUrl"])
        t = self.b.call("Target.createTarget", url=ORIGIN + "/" + LOCALE,
                        background=True)
        self.tid = t["targetId"]
        try:
            tgt = next(x for x in _http_json("/json/list")
                       if x["id"] == self.tid)
            self.p = WS(tgt["webSocketDebuggerUrl"], timeout=90)
            self._wait_ready()
        except BaseException:
            self.close()
            raise

    def _wait_ready(self, limit=25):
        t0 = time.time()
        while time.time() - t0 < limit:
            r = self.eval("location.origin + '|' + document.readyState")
            if r and r.startswith(ORIGIN) and r.endswith(("interactive", "complete")):
                return
            time.sleep(0.5)
        raise Net("ubereats.com did not load in the background tab")

    def eval(self, expr):
        r = self.p.call("Runtime.evaluate", expression=expr,
                        awaitPromise=True, returnByValue=True)
        if r.get("exceptionDetails"):
            raise ApiError("page script failed: " + str(
                r["exceptionDetails"].get("exception", {}).get("description")
                or r["exceptionDetails"].get("text")))
        return r.get("result", {}).get("value")

    def api(self, name, body):
        js = ("fetch(%s,{method:'POST',credentials:'include',headers:"
              "{'content-type':'application/json','x-csrf-token':'x'},body:%s})"
              ".then(async r=>({http:r.status,text:await r.text()}))"
              % (json.dumps(f"/_p/api/{name}?localeCode={LOCALE}"),
                 json.dumps(json.dumps(body))))
        if self.debug:
            print(f"> POST {name} {json.dumps(body, ensure_ascii=False)}",
                  file=sys.stderr)
        r = self.eval(js)
        if self.debug:
            print(f"< {r['http']} {r['text'][:300]}", file=sys.stderr)
        return parse_reply(name, r["http"], r["text"])

    def cookies(self):
        return self.p.call("Network.getCookies", urls=[ORIGIN])["cookies"]

    def close(self):
        try:
            self.b.call("Target.closeTarget", targetId=self.tid)
        except Exception:
            pass
        for w in (getattr(self, "p", None), getattr(self, "b", None)):
            if w:
                w.close()

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()


def parse_reply(name, http, text):
    if http == 403 or text.lstrip().startswith("<"):
        raise Blocked(f"{name}: blocked by Uber Eats (HTTP {http})")
    try:
        j = json.loads(text)
    except ValueError:
        raise ApiError(f"{name}: non-JSON reply (HTTP {http})")
    if j.get("status") != "success":
        msg = (j.get("data") or {}).get("message") or j.get("status")
        if http in (401,) or "auth" in str(msg).lower():
            raise Auth(f"{name}: not signed in ({msg}) - run `ubereats login`")
        raise ApiError(f"{name}: {msg}", {"http": http, "endpoint": name})
    return j.get("data") or {}


# ------------------------------------------------------------------ state
def _keyring(op, secret=None):
    acct = "default"
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct,
                           "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct,
                           "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct,
                           "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=ubereats-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None,
                               capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("UBEREATS_COOKIE"):
        st["cookie"], st["source"] = os.environ["UBEREATS_COOKIE"].strip(), "env"
    elif st.get("cookie_in_keyring"):
        st["cookie"], st["source"] = _keyring("get"), "keyring"
    elif st.get("cookie"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k != "source"}
    if out.get("cookie_in_keyring"):
        out.pop("cookie", None)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.replace(tmp, STATE_FILE)


def jwt_exp(cookie):
    m = re.search(r"(?:^|;\s*)jwt-session=([^;]+)", cookie or "")
    if not m:
        return None
    try:
        part = m.group(1).split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4))).get("exp")
    except (IndexError, ValueError):
        return None


def loc_cookie(addr):
    loc = {"address": {"address1": addr["label"], "address2": "", "aptOrSuite": "",
                       "eaterFormattedAddress": "", "subtitle": "",
                       "title": addr["label"], "uuid": ""},
           "latitude": addr["lat"], "longitude": addr["lng"],
           "reference": addr.get("reference", ""),
           "referenceType": addr.get("referenceType", "google_places"),
           "type": addr.get("referenceType", "google_places")}
    return "uev2.loc=" + urllib.parse.quote(json.dumps(loc, ensure_ascii=False))


def cookie_header(st):
    parts = []
    if st.get("cookie"):
        parts.append(re.sub(r"(?:^|;\s*)uev2\.loc=[^;]*", "", st["cookie"]).strip("; "))
    if st.get("address"):
        parts.append(loc_cookie(st["address"]))
    return "; ".join(p for p in parts if p)


# -------------------------------------------------------------- transport
class Http:
    """Direct HTTPS to the JSON API. Portable: no browser needed."""

    def __init__(self, st, debug=False):
        self.st, self.debug = st, debug

    def api(self, name, body):
        h = {"content-type": "application/json", "x-csrf-token": "x",
             "User-Agent": UA, "Origin": ORIGIN, "Referer": f"{ORIGIN}/{LOCALE}",
             "Accept": "application/json"}
        ck = cookie_header(self.st)
        if ck:
            h["Cookie"] = ck
        if self.debug:
            print(f"> POST {name} {json.dumps(body, ensure_ascii=False)}", file=sys.stderr)
        req = urllib.request.Request(f"{ORIGIN}/_p/api/{name}?localeCode={LOCALE}",
                                     data=json.dumps(body).encode(), headers=h)
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                code, text = r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            code, text = e.code, e.read().decode("utf-8", "replace")
        except OSError as e:
            raise Net(f"{name}: {e}")
        if self.debug:
            print(f"< {code} {text[:300]}", file=sys.stderr)
        return parse_reply(name, code, text)

    def close(self):
        pass

    def __enter__(self):
        return self

    def __exit__(self, *a):
        pass


class Auto:
    """HTTP first; on a bot wall, retry that call in a CDP background tab."""

    def __init__(self, args):
        self.args, self.st = args, load_state()
        self.http, self.br = Http(self.st, args.debug), None
        if self.st.get("cookie") and jwt_exp(self.st["cookie"]) and \
                jwt_exp(self.st["cookie"]) < time.time():
            print("warning: saved Uber Eats session expired - run `ubereats login`",
                  file=sys.stderr)

    def api(self, name, body):
        if self.args.via != "browser":
            try:
                return self.http.api(name, body)
            except Blocked:
                if self.args.via == "http":
                    raise
                print(f"note: {name} blocked over HTTP, retrying via browser",
                      file=sys.stderr)
        if not self.br:
            self.br = Browser(self.args.debug)
        return self.br.api(name, body)

    def __enter__(self):
        return self

    def __exit__(self, *a):
        if self.br:
            self.br.close()


# --------------------------------------------------------------- helpers
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)


def store_uuid(ref):
    """Accept a store UUID, a /store/<slug>/<b64> URL, or the bare b64 id."""
    ref = ref.strip()
    if UUID_RE.match(ref):
        return ref.lower()
    seg = ref
    if "/" in ref:
        path = urllib.parse.urlparse(ref).path.rstrip("/")
        parts = path.split("/")
        if "store" not in parts:
            raise ApiError(f"not an Uber Eats store URL: {ref}")
        seg = parts[parts.index("store") + 2] if len(parts) > parts.index("store") + 2 else parts[-1]
    seg = urllib.parse.unquote(seg)
    if UUID_RE.match(seg):
        return seg.lower()
    try:
        raw = base64.urlsafe_b64decode(seg + "=" * (-len(seg) % 4))
        return str(uuidlib.UUID(bytes=raw))
    except (ValueError, TypeError):
        raise ApiError(f"cannot read a store id from {ref!r}")


def _text(v):
    if isinstance(v, dict):
        return v.get("text") or ""
    return v or ""


def parse_store(d):
    items, seen, sections = [], set(), []
    for sec_list in (d.get("catalogSectionsMap") or {}).values():
        for sec in sec_list or []:
            pl = (sec.get("payload") or {}).get("standardItemsPayload") or {}
            title = _text(pl.get("title"))
            rows = []
            for it in pl.get("catalogItems") or []:
                row = {
                    "uuid": it.get("uuid"),
                    "title": it.get("title"),
                    "price": money(it.get("price")),
                    "price_text": _text(it.get("priceTagline")),
                    "description": it.get("itemDescription") or "",
                    "sold_out": bool(it.get("isSoldOut")) or it.get("isAvailable") is False,
                    "has_options": bool(it.get("hasCustomizations")),
                    "section": title,
                    "section_uuid": it.get("sectionUuid"),
                    "subsection_uuid": it.get("subsectionUuid"),
                    "image": it.get("imageUrl"),
                    "duplicate": it.get("uuid") in seen,
                }
                seen.add(it.get("uuid"))
                rows.append(row)
            sections.append({"title": title, "count": len(rows)})
            items.extend(rows)
    loc = d.get("location") or {}
    rating = d.get("rating") or {}
    return {
        "uuid": d.get("uuid"),
        "title": d.get("title"),
        "url": f"{ORIGIN}/{LOCALE}/store/{d.get('slug')}/"
               + base64.urlsafe_b64encode(uuidlib.UUID(d["uuid"]).bytes).decode().rstrip("=")
        if d.get("uuid") and d.get("slug") else None,
        "is_open": d.get("isOpen"),
        "is_orderable": d.get("isOrderable"),
        "closed_message": d.get("closedMessage") or "",
        "eta": _text(d.get("etaRange")),
        "within_delivery_range": d.get("isWithinDeliveryRange"),
        "rating": rating.get("ratingValue"),
        "rating_count": _text(rating.get("reviewCount")) or rating.get("reviewCount"),
        "address": loc.get("address") or loc.get("streetAddress"),
        "currency": d.get("currencyCode"),
        "sections": sections,
        "items": items,
    }


def parse_item(d):
    groups = []
    for g in d.get("customizationsList") or []:
        groups.append({
            "uuid": g.get("uuid"),
            "title": g.get("title"),
            "min": g.get("minPermitted"),
            "max": g.get("maxPermitted"),
            "options": [{"uuid": o.get("uuid"), "title": o.get("title"),
                         "price": money(o.get("price")),
                         "sold_out": bool(o.get("isSoldOut"))}
                        for o in g.get("options") or []],
        })
    return {"uuid": d.get("uuid"), "title": d.get("title"),
            "price": money(d.get("price")),
            "description": d.get("itemDescription") or "",
            "sold_out": bool(d.get("isSoldOut")), "option_groups": groups}


SEARCH_BODY = {"date": "", "startTime": 0, "endTime": 0, "carouselId": "",
               "sortAndFilters": [], "marketingFeedType": "",
               "billboardUuid": "", "feedProvider": "", "promotionUuid": "",
               "targetingStoreTag": "", "venueUUID": "",
               "selectedSectionUUID": "", "favorites": "", "vertical": "",
               "searchSource": "SEARCH_SUGGESTION",
               "displayType": "SEARCH_RESULTS", "keyName": ""}


def parse_search(d):
    out = []
    for f in d.get("feedItems") or []:
        s = f.get("store")
        if not s:
            continue
        meta = [_text(m) for m in s.get("meta") or []]
        rating = s.get("rating") or {}
        uid = s.get("storeUuid")
        out.append({"uuid": uid, "title": _text(s.get("title")),
                    "meta": [m for m in meta if m],
                    "rating": _text(rating) or None,
                    "url": f"{ORIGIN}/{LOCALE}/store/x/" +
                    base64.urlsafe_b64encode(uuidlib.UUID(uid).bytes).decode().rstrip("=")
                    if uid else None})
    return out


# --------------------------------------------------------------- commands
def cmd_doctor(args):
    checks = []
    st = load_state()
    checks.append(["state", "ok" if os.path.exists(STATE_FILE) else "-", STATE_FILE])
    try:
        Http(st, args.debug).api("getSearchSuggestionsV1", {"userQuery": "pizza", "vertical": "ALL"})
        checks.append(["http", "ok", "direct API reachable (no browser needed)"])
    except (Net, ApiError) as e:
        checks.append(["http", "FAIL", str(e)])
    try:
        ver = _http_json("/json/version")
        checks.append(["cdp", "ok", f"{CDP} {ver.get('Browser')} (fallback)"])
    except Net:
        checks.append(["cdp", "-", f"no browser on {CDP} (only needed for fallback / login --from-browser)"])
    a = st.get("address")
    checks.append(["address", "ok" if a else "-", a["label"] if a else "unset: Uber Eats guesses from IP"])
    if st.get("cookie"):
        try:
            u = Http(st, args.debug).api("getUserV1", {})
            checks.append(["login", "ok", f"{u.get('firstName') or ''} via {st.get('source')}"])
        except (Auth, ApiError, Net) as e:
            checks.append(["login", "FAIL", f"saved session rejected: {e}"])
    else:
        checks.append(["login", "-", "not signed in (read-only works)"])
    bad = any(c[1] == "FAIL" for c in checks)
    payload = err("doctor found problems", EX_NET, checks=checks) if bad else ok({"checks": checks})
    if bad and not args.json:
        print(table(checks, ["check", "state", "detail"]))
    return emit(payload, args.json, lambda: table(checks, ["check", "state", "detail"]))


def cmd_search(args):
    with Auto(args) as br:
        if args.suggest:
            d = br.api("getSearchSuggestionsV1",
                       {"userQuery": args.query, "vertical": "ALL"})
            rows = [{"type": x.get("type"),
                     "title": (x.get("store") or {}).get("title") or x.get("title"),
                     "uuid": (x.get("store") or {}).get("uuid")} for x in d or []]
            return emit(ok(rows), args.json, lambda: table(
                [[r["type"], r["title"] or "", r["uuid"] or ""] for r in rows],
                ["type", "title", "uuid"]))
        d = br.api("getSearchFeedV1", dict(SEARCH_BODY, userQuery=args.query))
    rows = parse_search(d)[: args.limit]
    return emit(ok(rows), args.json, lambda: table(
        [[i + 1, clip(r["title"], 40), clip(" · ".join(r["meta"]), 30), r["uuid"]]
         for i, r in enumerate(rows)], ["#", "store", "info", "uuid"]))


def cmd_store(args):
    sid = store_uuid(args.store)
    with Auto(args) as br:
        s = parse_store(br.api("getStoreV1", {"storeUuid": sid,
                                              "diningMode": args.mode}))
    if not args.all:
        s["items"] = [i for i in s["items"] if not i["duplicate"]]
    if args.available:
        s["items"] = [i for i in s["items"] if not i["sold_out"]]
    if args.grep:
        g = args.grep.lower()
        s["items"] = [i for i in s["items"]
                      if g in (i["title"] or "").lower() or g in i["description"].lower()]

    def human():
        head = (f"{s['title']}  ({'open' if s['is_open'] else 'CLOSED'}"
                f"{', ' + s['eta'] if s['eta'] else ''})\n"
                f"{s['url'] or ''}\n")
        if s["closed_message"]:
            head += s["closed_message"] + "\n"
        rows = [[clip(i["section"], 16), clip(i["title"], 34),
                 i["price_text"] or i["price"], "SOLD OUT" if i["sold_out"] else "",
                 "+opt" if i["has_options"] else ""] for i in s["items"]]
        return head + "\n" + table(rows, ["section", "item", "price", "", ""])
    return emit(ok(s), args.json, human)


def cmd_item(args):
    sid = store_uuid(args.store)
    with Auto(args) as br:
        s = parse_store(br.api("getStoreV1", {"storeUuid": sid,
                                              "diningMode": "DELIVERY"}))
        q = args.item.lower()
        hit = next((i for i in s["items"] if i["uuid"] == args.item), None) or \
            next((i for i in s["items"] if (i["title"] or "").lower() == q), None) or \
            next((i for i in s["items"] if q in (i["title"] or "").lower()), None)
        if not hit:
            raise ApiError(f"no item matching {args.item!r} in {s['title']}")
        d = br.api("getMenuItemV1", {"itemRequestType": "ITEM", "storeUuid": sid,
                                     "sectionUuid": hit["section_uuid"],
                                     "subsectionUuid": hit["subsection_uuid"],
                                     "menuItemUuid": hit["uuid"]})
    it = parse_item(d)

    def human():
        out = [f"{it['title']}  ${it['price']:g}" + ("  SOLD OUT" if it["sold_out"] else ""),
               it["description"], ""]
        for g in it["option_groups"]:
            need = ("required" if (g["min"] or 0) > 0 else "optional") + \
                   f", pick {g['min']}-{g['max']}"
            out.append(f"[{g['title']}] ({need})")
            for o in g["options"]:
                extra = f" +${o['price']:g}" if o["price"] else ""
                out.append(f"  - {o['title']}{extra}" + (" (sold out)" if o["sold_out"] else ""))
        return "\n".join(out)
    return emit(ok(it), args.json, human)


def cmd_raw(args):
    with Auto(args) as br:
        d = br.api(args.endpoint, json.loads(args.body or "{}"))
    return emit(ok(d), True)


def _verify(cookie, debug):
    try:
        u = Http({"cookie": cookie}, debug).api("getUserV1", {})
    except (Auth, ApiError) as e:
        raise Auth(f"that session is not signed in to Uber Eats ({e}). "
                   "sign in on ubereats.com first, then copy the session again")
    if not u.get("uuid"):
        raise Auth("getUserV1 returned no user - not signed in")
    return u


def cmd_login(args):
    if args.from_browser:
        with Browser(args.debug, args.cdp) as br:
            cks = br.cookies()
        cookie = "; ".join(f"{c['name']}={c['value']}" for c in cks
                           if c["name"] != "uev2.loc")
        src = f"browser {args.cdp or CDP}"
    elif args.cookie_stdin:
        cookie = sys.stdin.readline().strip()
        if cookie.lower().startswith("cookie:"):
            cookie = cookie.split(":", 1)[1].strip()
        src = "stdin"
    else:
        raise ApiError("pick --from-browser or --cookie-stdin", {"usage": True})
    if not cookie:
        raise Auth("empty cookie")
    u = _verify(cookie, args.debug)
    st = load_state()
    st.pop("source", None)
    st.update(cookie=cookie, cookie_in_keyring=bool(args.keyring),
              user={"uuid": u.get("uuid"), "first_name": u.get("firstName")},
              logged_in_at=int(time.time()), exp=jwt_exp(cookie), login_source=src)
    if args.keyring:
        _keyring("set", cookie)
    save_state(st)
    out = {"user": st["user"], "stored": "keyring" if args.keyring else STATE_FILE,
           "expires": st["exp"]}
    return emit(ok(out), args.json,
                lambda: f"signed in as {u.get('firstName') or u.get('uuid')}; "
                        f"session saved to {out['stored']}")


def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        _keyring("del")
    for k in ("cookie", "cookie_in_keyring", "user", "logged_in_at", "exp",
              "login_source", "source"):
        st.pop(k, None)
    save_state(st)
    return emit(ok({"logged_out": True}), args.json, "session removed")


def cmd_whoami(args):
    st = load_state()
    if not st.get("cookie"):
        raise Auth("not signed in - run `ubereats login`")
    u = _verify(st["cookie"], args.debug)
    out = {"uuid": u.get("uuid"), "first_name": u.get("firstName"),
           "last_name": u.get("lastName"), "source": st.get("source"),
           "expires": st.get("exp")}
    return emit(ok(out), args.json, lambda: f"{out['first_name'] or ''} {out['last_name'] or ''} "
                                            f"({out['uuid']}) via {out['source']}")


def cmd_address(args):
    st = load_state()
    st.pop("source", None)
    if args.action == "set":
        if args.lat is None or args.lng is None:
            raise ApiError("address set needs --lat and --lng (copy from the store URL's pl= "
                           "parameter or Google Maps)")
        st["address"] = {"label": args.label, "lat": args.lat, "lng": args.lng,
                         "reference": args.place_id or "", "referenceType": "google_places"}
        save_state(st)
    elif args.action == "clear":
        st.pop("address", None)
        save_state(st)
    elif args.action == "from-url":
        q = urllib.parse.parse_qs(urllib.parse.urlparse(args.label).query).get("pl")
        if not q:
            raise ApiError("that URL has no pl= address parameter")
        d = json.loads(urllib.parse.unquote(base64.b64decode(urllib.parse.unquote(q[0])).decode()))
        st["address"] = {"label": d.get("address"), "lat": d["latitude"], "lng": d["longitude"],
                         "reference": d.get("reference", ""),
                         "referenceType": d.get("referenceType", "google_places")}
        save_state(st)
    a = st.get("address")
    return emit(ok(a), args.json, lambda: f"{a['label']} ({a['lat']}, {a['lng']})" if a else "(no address)")


def build_parser():
    p = argparse.ArgumentParser(prog="ubereats",
                                description="Uber Eats Taiwan from the shell "
                                            "(read-only).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true",
                        help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true",
                        help="dump API calls to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport: direct HTTP, CDP browser tab, or HTTP with "
                             "browser fallback (default)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor", parents=[common],
                   help="browser, API reachability, login state"
                   ).set_defaults(fn=cmd_doctor)

    lg = sub.add_parser("login", parents=[common],
                        help="save a signed-in Uber Eats session")
    g = lg.add_mutually_exclusive_group(required=True)
    g.add_argument("--from-browser", action="store_true",
                   help="copy the session from a CDP browser where you signed in")
    g.add_argument("--cookie-stdin", action="store_true",
                   help="read a DevTools Cookie request header from stdin")
    lg.add_argument("--cdp", help=f"CDP endpoint (default {CDP})")
    lg.add_argument("--keyring", action="store_true",
                    help="store the cookie in the OS keyring, not the state file")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="forget the saved session"
                   ).set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="who the saved session is"
                   ).set_defaults(fn=cmd_whoami)
    ad = sub.add_parser("address", parents=[common], help="delivery address")
    ad.add_argument("action", nargs="?", default="show",
                    choices=["show", "set", "clear", "from-url"])
    ad.add_argument("label", nargs="?", default="",
                    help="address text (set) or a store URL with pl= (from-url)")
    ad.add_argument("--lat", type=float)
    ad.add_argument("--lng", type=float)
    ad.add_argument("--place-id")
    ad.set_defaults(fn=cmd_address)

    s = sub.add_parser("search", parents=[common], help="find stores")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=15)
    s.add_argument("--suggest", action="store_true",
                   help="typeahead suggestions instead of full results")
    s.set_defaults(fn=cmd_search)

    st = sub.add_parser("store", aliases=["menu"], parents=[common],
                        help="store status, ETA and full menu")
    st.add_argument("store", help="store URL, UUID, or the base64 id")
    st.add_argument("--mode", default="DELIVERY",
                    choices=["DELIVERY", "PICKUP"])
    st.add_argument("--available", action="store_true",
                    help="hide sold-out items")
    st.add_argument("--grep", help="filter items by name/description")
    st.add_argument("--all", action="store_true",
                    help="keep items repeated in featured sections")
    st.set_defaults(fn=cmd_store)

    it = sub.add_parser("item", parents=[common],
                        help="one item with its option groups")
    it.add_argument("store", help="store URL, UUID, or the base64 id")
    it.add_argument("item", help="item UUID or (part of) its name")
    it.set_defaults(fn=cmd_item)

    r = sub.add_parser("raw", parents=[common],
                       help="call any /_p/api endpoint (read-only use)")
    r.add_argument("endpoint", help="e.g. getStoreV1")
    r.add_argument("--body", help="JSON body")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
