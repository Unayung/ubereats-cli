def find_item(s, ref):
    """Item by UUID, exact title, then substring; real-section copies before featured ones."""
    items, q = sorted(s["items"], key=lambda i: i["duplicate"]), ref.lower()
    hit = next((i for i in items if i["uuid"] == ref), None) or \
        next((i for i in items if (i["title"] or "").lower() == q), None) or \
        next((i for i in items if q in (i["title"] or "").lower()), None)
    if not hit:
        raise ApiError(f"no item matching {ref!r} in {s['title']}")
    return hit


def cmd_item(args):
    sid = store_uuid(args.store)
    with Auto(args) as br:
        s = parse_store(br.api("getStoreV1", {"storeUuid": sid,
                                              "diningMode": args.mode}))
        hit = find_item(s, args.item)
        d = br.api("getMenuItemV1", {"itemRequestType": "ITEM", "storeUuid": sid,
                                     "sectionUuid": hit["section_uuid"],
                                     "subsectionUuid": hit["subsection_uuid"],
                                     "menuItemUuid": hit["uuid"]})
    it = parse_item(d)

    def human():
        price = f"  ${it['price']:g}" if it["price"] is not None else ""
        out = [f"{it['title']}{price}" + ("  SOLD OUT" if it["sold_out"] else ""),
               it["description"], ""]
        for g in it["option_groups"]:
            need = ("required" if (g["min"] or 0) > 0 else "optional") + \
                   f", pick {g['min']}-{g['max']}"
            out.append(f"[{g['title']}] ({need})")
            for o in g["options"]:
                extra = f" +${o['price']:g}" if o["price"] else ""
                out.append(f"  - {o['title']}{extra}" + (" (sold out)" if o["sold_out"] else ""))
        return "\n".join(out)
    return emit(ok(it), args.json, human)


def group_uuid(ref):
    """Accept a group-order link (eats.uber.com/group-orders/<uuid>/join) or the bare UUID."""
    m = re.search(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", ref, re.I)
    if not m:
        raise ApiError(f"not an Uber Eats group order link: {ref}")
    return m.group(0).lower()


def group_meta(br, gid):
    """What the join page shows; works before joining (getDraftOrderByUuidV2 does not)."""
    d = br.api("getJoinGroupOrderMetaV1", {"draftOrderUUID": gid})
    mine = {o.get("uuid") for o in
            br.api("getDraftOrdersByEaterUuidV1", {}).get("draftOrders") or []}
    p = d.get("joinGroupOrderPresentationData") or {}
    lines = {i.get("icon"): i.get("title") for i in p.get("items") or []}
    sid = d.get("storeUUID")
    return {"uuid": gid, "title": p.get("title"), "store": lines.get("STOREFRONT"),
            "deliver_to": lines.get("LOCATION_MARKER"), "payment": lines.get("MONEY"),
            "bill_split": d.get("billSplitOption"),
            # ponytail: anything but CREATOR_PAYS_ALL counts as "you pay" until other values are seen
            "you_pay": d.get("billSplitOption") != "CREATOR_PAYS_ALL",
            "joined": gid in mine, "store_uuid": sid,
            "store_url": f"{ORIGIN}/{LOCALE}/store/x/"
            + base64.urlsafe_b64encode(uuidlib.UUID(sid).bytes).decode().rstrip("=") if sid else None}


def group_order(br, gid):
    try:
        return br.api("getDraftOrderByUuidV2", {"draftOrderUUID": gid}).get("draftOrder") or {}
    except Auth:
        raise Auth(f"not a member of group order {gid} (run `ubereats group join`), "
                   "or not signed in")


def group_closed(do):
    """Why a group order you are in no longer takes items, else None. state stays
    UNORDERED after the host locks the cart or the group expires."""
    if do.get("state") != "UNORDERED":
        return do.get("state")
    if (do.get("shoppingCart") or {}).get("cartState") == "LOCKED":
        return "LOCKED"
    # same ISO-8601 UTC layout on both sides, so string order is time order
    if (do.get("expiresAt") or "~")[:19] < time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime()):
        return "EXPIRED"
    return None


def group_members(do):
    return [{"name": m.get("name"), "is_creator": m.get("isCreator"), "is_you": m.get("isCurrentUser"),
             "items": [{"cart_item": x.get("shoppingCartItemUuid"), "title": x.get("title"),
                        "quantity": x.get("quantity"), "price": money(x.get("price")),
                        "options": [o.get("title") for os_ in (x.get("customizations") or {}).values()
                                    for o in os_],
                        "note": x.get("specialInstructions") or ""}
                       for x in m.get("items") or []]}
            for m in (do.get("shoppingCart") or {}).get("groupedItems") or []]


def pick_options(m, wanted):
    """--opt texts -> the customizations map addItemsToGroupDraftOrderV2 takes.
    Key "<group uuid>+<groupId>"; a nested group (份量 under 少冰) is keyed by its
    path "<group>+<id>,<option uuid>,<child group>+<id>" like the web app does.
    An --opt that equals some option title anywhere only matches exactly, so 大
    never picks 大珍珠; otherwise it matches by substring. Unset required groups
    take their default options, as the web app does."""
    def tree(gs):
        for g in gs or []:
            for o in g.get("options") or []:
                yield o
                yield from tree(o.get("childCustomizationList"))
    titles = {(o.get("title") or "").lower() for o in tree(m.get("customizationsList"))}
    left, cust = list(wanted), {}

    def walk(groups, prefix):
        for g in groups or []:
            key, opts, picked = f"{prefix}{g['uuid']}+{g.get('groupId')}", g.get("options") or [], []
            for w in list(left):
                lw = w.lower()
                c = [o for o in opts if (o.get("title") or "").lower() == lw] if lw in titles \
                    else [o for o in opts if lw in (o.get("title") or "").lower()]
                if len(c) > 1:
                    raise ApiError(f"--opt {w!r} matches {len(c)} options: "
                                   + ", ".join(o.get("title") for o in c))
                if c:
                    picked.append(c[0])
                    left.remove(w)
            lo, hi = g.get("minPermitted") or 0, g.get("maxPermitted")
            if not picked and lo:
                picked = [o for o in opts if (o.get("defaultQuantity") or 0) >= 1 and not o.get("isSoldOut")]
            if len(picked) < lo or (hi is not None and len(picked) > hi):
                raise ApiError(f"[{g.get('title')}] needs {lo}-{hi} --opt: "
                               + " / ".join(o.get("title") for o in opts))
            for o in picked:
                if o.get("isSoldOut"):
                    raise ApiError(f"{o.get('title')} is sold out")
                walk(o.get("childCustomizationList"), f"{key},{o['uuid']},")
            if picked:
                cust[key] = [{"uuid": o["uuid"], "price": o.get("price") or 0, "quantity": 1,
                              "title": o.get("title"), "defaultQuantity": o.get("defaultQuantity") or 0,
                              "customizationMeta": {"title": g.get("title"), "isPickOne": False}}
                             for o in picked]
    walk(m.get("customizationsList"), "")
    if left:
        raise ApiError(f"no option matching {', '.join(map(repr, left))} with your other choices")
    return cust


def _members_text(members):
    out = []
    for m in members:
        out.append(f"  {m['name']}" + (" (host)" if m["is_creator"] else "") + (" <- you" if m["is_you"] else ""))
        for x in m["items"]:
            out.append(f"    {x['quantity']}x {x['title']} {' / '.join(x['options'])}"
                       + (f"  [{x['note']}]" if x["note"] else ""))
    return out


def cmd_group(args):
    if args.action == "list":
        with Auto(args) as br:
            rows = []
            for d in br.api("getDraftOrdersByEaterUuidV1", {}).get("draftOrders") or []:
                p = br.api("getJoinGroupOrderMetaV1", {"draftOrderUUID": d.get("uuid")}
                           ).get("joinGroupOrderPresentationData") or {}
                store = next((i.get("title") for i in p.get("items") or []
                              if i.get("icon") == "STOREFRONT"), None)
                rows.append({"uuid": d.get("uuid"), "title": d.get("displayName"), "store": store,
                             "host": d.get("isUserCreator"), "created_at": d.get("createdAt"),
                             "closed": group_closed(d),
                             "members": (d.get("shoppingCart") or {}).get("numMembers")})
        return emit(ok(rows), args.json, lambda: table(
            [[r["title"], clip(r["store"], 24), r["closed"] or "open", (r["created_at"] or "")[:10],
              r["uuid"]] for r in rows], ["group", "store", "state", "created", "uuid"])
            if rows else "(no group orders)")
    if not args.link:
        raise ApiError(f"group {args.action} needs a group order link", {"usage": True})
    gid = group_uuid(args.link)
    with Auto(args) as br:
        g = group_meta(br, gid)
        do = group_order(br, gid) if g["joined"] else {}
        if args.action == "peek":
            if do:
                g.update(state=do.get("state"), closed=group_closed(do),
                         expires_at=do.get("expiresAt"), members=group_members(do))
            # ponytail: non-members cannot see open/closed; every read endpoint needs membership
            status = (f"joined, {g['closed'] or 'open'}" if do else
                      "not joined (whether it is still open shows only after joining)")
            return emit(ok(g), args.json, lambda: "\n".join(
                [g["title"] or gid, f"  {g['store']}", f"  {g['deliver_to']}",
                 f"  {g['payment']}" + (f"  [{g['bill_split']}: you pay]" if g["you_pay"] else ""),
                 f"  {status}",
                 f"  menu: ubereats store {g['store_uuid']}"] + _members_text(g.get("members") or [])))

        if args.action == "join":
            if g["joined"]:
                return emit(ok(dict(g, already_joined=True)), args.json, "already in this group order")
            if not args.yes:
                return emit(ok(dict(g, dry_run=True)), args.json,
                            f"would join: {g['title']} ({g['store']}). re-run with --yes")
            br.api("addMemberToDraftOrderV1", {"draftOrderUuid": gid,
                                               **({"nickname": args.nickname} if args.nickname else {})})
            closed = group_closed(group_order(br, gid))
            return emit(ok(dict(g, joined=True, closed=closed)), args.json,
                        f"joined {g['title']}" + (f", but it is {closed}" if closed else ""))

        if not g["joined"]:
            raise Auth("not in this group order (join: ubereats group join <link> --yes)")
        if args.action == "leave":
            if not args.yes:
                return emit(ok(dict(g, dry_run=True)), args.json,
                            f"would leave: {g['title']} ({g['store']}). re-run with --yes")
            br.api("removeMemberFromDraftOrderV1", {"draftOrderUuid": gid, "shouldClearCookies": False})
            # the reply is a bare success even when nothing changed (seen on a LOCKED, expired group)
            if gid in {o.get("uuid") for o in
                       br.api("getDraftOrdersByEaterUuidV1", {}).get("draftOrders") or []}:
                raise ApiError(f"Uber Eats accepted the leave but you are still in the group "
                               f"({group_closed(do) or 'open'})")
            return emit(ok(dict(g, joined=False)), args.json, f"left {g['title']}")

        closed = group_closed(do)
        if closed:
            raise ApiError(f"group order is {closed}, no longer editable")
        cart = (do.get("shoppingCart") or {}).get("cartUuid")
        if not args.item:
            raise ApiError(f"group {args.action} needs an item", {"usage": True})

        if args.action == "rm":
            mine = next((m for m in group_members(do) if m["is_you"]), {"items": []})["items"]
            hits = [x for x in mine if args.item in (x["cart_item"], x["title"])] or \
                [x for x in mine if args.item.lower() in (x["title"] or "").lower()]
            if len(hits) != 1:
                raise ApiError(f"{len(hits)} of your items match {args.item!r}",
                               {"yours": [f"{x['title']} {x['cart_item']}" for x in mine]})
            if not args.yes:
                return emit(ok({"dry_run": True, "remove": hits[0]}), args.json,
                            f"would remove {hits[0]['title']}. re-run with --yes")
            br.api("removeItemsFromGroupDraftOrderV2", {"draftOrderUUID": gid, "cartUUID": cart,
                                                        "shoppingCartItemUUIDs": [hits[0]["cart_item"]]})
            return emit(ok({"removed": hits[0]}), args.json, f"removed {hits[0]['title']}")

        # add
        if g["you_pay"] and not args.i_pay:
            raise ApiError(f"this group is {g['bill_split']}: you pay for what you add. "
                           "re-run with --i-pay if that is intended")
        s = parse_store(br.api("getStoreV1", {"storeUuid": g["store_uuid"], "diningMode": "DELIVERY"}))
        hit = find_item(s, args.item)
        if hit["sold_out"]:
            raise ApiError(f"{hit['title']} is sold out")
        m = br.api("getMenuItemV1", {"itemRequestType": "ITEM", "storeUuid": g["store_uuid"],
                                     "sectionUuid": hit["section_uuid"],
                                     "subsectionUuid": hit["subsection_uuid"],
                                     "menuItemUuid": hit["uuid"]})
        cust = pick_options(m, args.opt or [])
        line = {"uuid": hit["uuid"], "shoppingCartItemUuid": str(uuidlib.uuid4()),
                "storeUuid": g["store_uuid"], "sectionUuid": hit["section_uuid"],
                "subsectionUuid": hit["subsection_uuid"], "title": m.get("title") or hit["title"],
                "price": m.get("price"), "quantity": args.qty,
                "specialInstructions": args.note or "", "customizations": cust}
        opts = [o["title"] for os_ in cust.values() for o in os_]
        each = ((m.get("price") or 0) + sum(o["price"] for os_ in cust.values() for o in os_)) / 100
        summary = {"item": line["title"], "options": opts, "quantity": args.qty,
                   "each": each, "total": each * args.qty, "note": args.note or "",
                   "group": g["title"], "you_pay": g["you_pay"]}
        desc = f"{args.qty}x {line['title']} {' / '.join(opts)}  ${each * args.qty:g}"
        if not args.yes:
            return emit(ok(dict(summary, dry_run=True)), args.json,
                        f"would add to {g['title']}: {desc}. re-run with --yes")
        r = br.api("addItemsToGroupDraftOrderV2", {"draftOrderUUID": gid, "cartUUID": cart,
                                                   "items": [line]})
        if r.get("validationErrors"):
            raise ApiError("Uber Eats rejected the item", {"validationErrors": r["validationErrors"]})
        return emit(ok(dict(summary, cart_item=line["shoppingCartItemUuid"])), args.json,
                    f"added: {desc}")


def cmd_raw(args):
    # ponytail: name-prefix allowlist; Uber's reads are get*V1, cart/checkout are not
    if not args.endpoint.startswith("get"):
        raise ApiError(f"raw only calls read endpoints (get*), not {args.endpoint!r}",
                       {"usage": True})
