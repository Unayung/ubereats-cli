    out = {"uuid": u.get("uuid"), "first_name": u.get("firstName"),
           "last_name": u.get("lastName"), "source": st.get("source"),
           "expires": st.get("exp")}
    return emit(ok(out), args.json, lambda: f"{out['first_name'] or ''} {out['last_name'] or ''} "
                                            f"({out['uuid']}) via {out['source']}")


def cmd_address(args):
    st = load_state()
    st.pop("source", None)
    if args.action == "set":
        if (args.lat is None) != (args.lng is None):
            raise ApiError("give both --lat and --lng, or neither to look the address up")
        if args.lat is None:
            # ponytail: first autocomplete hit, the printed match is the user's check
            with Auto(args) as br:
                hits = br.api("mapsSearchV1", {"query": args.label})
                if not hits:
                    raise ApiError(f"Uber Eats found no address for {args.label!r}")
                d = br.api("getDeliveryLocationV1", {"placeId": hits[0]["id"],
                                                     "provider": hits[0]["provider"],
                                                     "source": "manual_auto_complete"})
            st["address"] = {"label": args.label, "lat": d["latitude"], "lng": d["longitude"],
                             "reference": d.get("reference", ""),
                             "referenceType": d.get("referenceType", "google_places"),
                             "matched": (d.get("address") or {}).get("eaterFormattedAddress")}
        else:
            st["address"] = {"label": args.label, "lat": args.lat, "lng": args.lng,
                             "reference": args.place_id or "", "referenceType": "google_places"}
        save_state(st)
    elif args.action == "clear":
        st.pop("address", None)
        save_state(st)
    elif args.action == "from-url":
        # not parse_qs: it turns base64 '+' into ' '
        q = re.search(r"(?:^|&)pl=([^&]+)", urllib.parse.urlparse(args.label).query)
        if not q:
            raise ApiError("that URL has no pl= address parameter")
        d = json.loads(urllib.parse.unquote(base64.b64decode(urllib.parse.unquote(q.group(1))).decode()))
        st["address"] = {"label": d.get("address"), "lat": d["latitude"], "lng": d["longitude"],
                         "reference": d.get("reference", ""),
                         "referenceType": d.get("referenceType", "google_places")}
        save_state(st)
    a = st.get("address")
    return emit(ok(a), args.json, lambda: f"{a['label']} ({a['lat']}, {a['lng']})"
                + (f"\nmatched: {a['matched']}" if a.get("matched") else "") if a else "(no address)")


def build_parser():
    p = argparse.ArgumentParser(prog="ubereats",
                                description="Uber Eats Taiwan from the shell "
                                            "(no checkout).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true",
                        help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true",
                        help="dump API calls to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport: direct HTTP, CDP browser tab, or HTTP with "
                             "browser fallback (default)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor", parents=[common],
                   help="browser, API reachability, login state"
                   ).set_defaults(fn=cmd_doctor)

    lg = sub.add_parser("login", parents=[common],
                        help="save a signed-in Uber Eats session")
    g = lg.add_mutually_exclusive_group(required=True)
    g.add_argument("--from-browser", action="store_true",
                   help="copy the session from a CDP browser where you signed in")
    g.add_argument("--cookie-stdin", action="store_true",
                   help="paste a DevTools Cookie request header (or pipe it in)")
    g.add_argument("--from-clipboard", action="store_true",
                   help="read the Cookie header from the clipboard (copy it in DevTools first)")
    lg.add_argument("--cdp", help=f"CDP endpoint (default {CDP})")
    lg.add_argument("--keyring", action="store_true",
                    help="store the cookie in the OS keyring, not the state file")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="forget the saved session"
                   ).set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="who the saved session is"
                   ).set_defaults(fn=cmd_whoami)
    ad = sub.add_parser("address", parents=[common], help="delivery address")
    ad.add_argument("action", nargs="?", default="show",
                    choices=["show", "set", "clear", "from-url"])
    ad.add_argument("label", nargs="?", default="",
                    help="address text (set) or a store URL with pl= (from-url)")
    ad.add_argument("--lat", type=float)
    ad.add_argument("--lng", type=float)
    ad.add_argument("--place-id")
    ad.set_defaults(fn=cmd_address)

    s = sub.add_parser("search", parents=[common], help="find stores")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=15)
    s.add_argument("--suggest", action="store_true",
                   help="typeahead suggestions instead of full results")
    s.set_defaults(fn=cmd_search)

    st = sub.add_parser("store", aliases=["menu"], parents=[common],
                        help="store status, ETA and full menu")
    st.add_argument("store", help="store URL, UUID, or the base64 id")
    st.add_argument("--mode", default="DELIVERY",
                    choices=["DELIVERY", "PICKUP"])
    st.add_argument("--available", action="store_true",
                    help="hide sold-out items")
    st.add_argument("--grep", help="filter items by name/description")
    st.add_argument("--all", action="store_true",
                    help="keep items repeated in featured sections")
    st.set_defaults(fn=cmd_store)

    it = sub.add_parser("item", parents=[common],
                        help="one item with its option groups")
    it.add_argument("store", help="store URL, UUID, or the base64 id")
    it.add_argument("item", help="item UUID or (part of) its name")
    it.add_argument("--mode", default="DELIVERY", choices=["DELIVERY", "PICKUP"])
    it.set_defaults(fn=cmd_item)

    gr = sub.add_parser("group", parents=[common], help="Uber Eats group orders (團購)")
    gr.add_argument("action", choices=["list", "peek", "join", "leave", "add", "rm"])
    gr.add_argument("link", nargs="?", help="group order link or its UUID (all but list)")
    gr.add_argument("item", nargs="?", help="add: item name/UUID; rm: your item's name or cart_item")
    gr.add_argument("--opt", action="append", help="option text, repeatable (微糖 / 少冰 / 珍珠)")
    gr.add_argument("--qty", type=int, default=1)
    gr.add_argument("--note", help="special instructions for the item")
    gr.add_argument("--nickname", help="join: name shown to the group")
    gr.add_argument("--yes", action="store_true", help="really write; without it join/leave/add/rm only preview")
    gr.add_argument("--i-pay", action="store_true",
                    help="allow add when the group splits the bill (you pay your items)")
    gr.set_defaults(fn=cmd_group)

    r = sub.add_parser("raw", parents=[common],
                       help="call a read-only /_p/api get* endpoint")
    r.add_argument("endpoint", help="e.g. getStoreV1")
    r.add_argument("--body", help="JSON body")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
